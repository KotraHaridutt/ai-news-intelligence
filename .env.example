# Copy to .env and fill in. Values need no quotes.

# --- Required ---
# Gemini (Google AI Studio). GEMINI_API_KEY works too.
GOOGLE_API_KEY=your_gemini_api_key
# GNews (https://gnews.io)
GNEWS_API_KEY=your_gnews_api_key

# --- Optional ---
# Upstash Redis, rediss:// (TLS). Without it, caching is off and following topics is unavailable.
REDIS_URL=rediss://default:your_password@your-db.upstash.io:6379
# How many new topics are built at the same time (default 3)
# MAX_CONCURRENT_BUILDS=3
# Answer models (Gemini 3+), default gemini-3.8-flash with gemini-3.6-flash as the fallback
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Gemini's own safety filter is OFF on every category (feature 3 #45). Set this to send the
# jailbreak category too, only after measuring it on dark-news topics (unset: not sent):
# OFF, BLOCK_NONE, BLOCK_ONLY_HIGH, BLOCK_MEDIUM_AND_ABOVE or BLOCK_LOW_AND_ABOVE
# GEMINI_JAILBREAK_THRESHOLD=

# --- LLM safety (optional, feature 3) ---
# Each guard: SAFETY_<CHECK>=off, monitor (default: record only) or enforce (act). E.g.
# SAFETY_INTENT=enforce
# SAFETY_RELEVANCE=monitor
# Personal data (H): monitor masks it in what leaves the app (Clef, LangSmith, logs); enforce also
# removes it from the search and masks unsourced contact details in answers. Names in comments: Clef.
# SAFETY_PII=monitor
# SAFETY_NAMES=monitor
# Model output into the page (I): monitor records links to pages that aren't the answer's sources and
# images; enforce turns such links into plain text and removes images. A cut answer gets a note either way.
# SAFETY_OUTPUT=monitor
# Faithfulness (J): every answer's sentences against its sources (Clef + figures/dates/sources);
# enforce shows a note under the answer when statements don't match. Nothing is ever removed.
# SAFETY_FAITHFULNESS=monitor
# A note under election, health, money and developing-story answers (enforce shows it)
# SAFETY_SENSITIVE_TOPIC=monitor
# None of the retrieved chunks is about the topic: enforce answers 404 'not enough coverage' before Gemini
# SAFETY_COVERAGE=monitor
# The model's own conduct (K): enforce withholds an answer whose OWN wording is hateful (quotes are news);
# leak (repeats its instructions) and balance (one-sided) are recorded only.
# SAFETY_TOXICITY=monitor
# SAFETY_LEAK=monitor
# SAFETY_BALANCE=monitor
# Sites never to use, exact domains (a domain covers its subdomains), comma-separated. Empty by default.
# SAFETY_BLOCKED_DOMAINS=

# --- LangSmith tracing (optional) ---
# A personal access token from smith.langchain.com > Settings > API Keys (starts lsv2_pt_)
LANGSMITH_API_KEY=
# Traces are sent only when this is true AND the key is set
LANGSMITH_TRACING=false
# dev locally, prod on Render; picks the default project (ai-news-dev / ai-news-prod)
APP_ENV=dev
# Overrides the project name (default ai-news-<APP_ENV>); LangSmith creates it on the first trace
# LANGSMITH_PROJECT=ai-news-dev
# Share of requests traced, 0 to 1 (default 1: all)
# LANGSMITH_TRACING_SAMPLING_RATE=1
# Only for an EU LangSmith account
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Observability extras (optional, feature 2) ---
# Gemini free tier: chat calls per model per day the counter and the eval budget assume (default 20)
# GEMINI_DAILY_LIMIT=20
# The free code checks on every answer, sent to the trace as feedback (default true)
# ONLINE_CHECKS=true
# Where prompts come from: code (default), or hub:<tag> to pull them from the LangSmith Prompt Hub
# PROMPT_SOURCE=code
# The evals' LLM judge (default gemini-3.8-flash)
# JUDGE_MODEL=gemini-3.8-flash
# Only for scripts/setup_monitoring.py: the ntfy.sh topic the LangSmith alerts go to (keep it secret)
# NTFY_ALERT_TOPIC=
